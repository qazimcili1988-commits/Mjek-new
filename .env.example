# NOTE: No API keys are required anymore! This app has been optimized to run
# 100% offline and locally in the browser, making it fully ready to be published
# directly to GitHub Pages as a static application with local PDF/Docx/TXT parsers.
# 
# GEMINI_API_KEY= (Not required)

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
